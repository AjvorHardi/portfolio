---
import { projects } from "../data/projects";
---

<section class="projects-section" id="projects" aria-labelledby="projects-title">
	<div class="section-heading">
		<p class="section-heading__eyebrow">Selected Works</p>
		<h2 id="projects-title">Projects</h2>
		<p class="section-heading__copy">
			[PLACEHOLDER INTRO] Replace with a short sentence introducing the work.
		</p>
	</div>

	<div class="projects-shell-grid" aria-label="Project placeholders">
		{
			projects.map((project, index) => (
				<article class="project-shell-card" aria-label={`Placeholder for ${project.name}`}>
					<p class="project-shell-card__index">{String(index + 1).padStart(2, "0")}</p>
					<h3>{project.name}</h3>
				</article>
			))
		}
	</div>
</section>
