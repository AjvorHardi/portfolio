---
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../data/projects";
---

<section class="projects-section" id="projects" aria-labelledby="projects-title">
	<div class="section-heading">
		<p class="section-heading__eyebrow">Selected Works</p>
		<h2 id="projects-title">Projects</h2>
		<p class="section-heading__copy">
			[PLACEHOLDER INTRO] Replace with a short sentence introducing the work.
		</p>
	</div>

	<div class="projects-grid" aria-label="Project list">
		{
			projects.map((project, index) => (
				<ProjectCard project={project} index={index} />
			))
		}
	</div>
</section>
