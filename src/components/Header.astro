---
import { site } from "../data/site";
---

<header class="site-header">
	<div class="page-frame site-header__inner site-header__inner--nav-only">
		<nav aria-label="Primary">
			<ul class="site-header__nav">
				<li>
					<a href="#projects">projects</a>
				</li>
				<li>
					<a href={`mailto:${site.email}`}>email</a>
				</li>
				<li>
					<a
						class="site-header__icon-link"
						href={site.githubUrl}
						target="_blank"
						rel="noreferrer"
						aria-label="GitHub"
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path
								d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.7c-2.78.6-3.37-1.2-3.37-1.2-.45-1.15-1.1-1.46-1.1-1.46-.9-.62.07-.6.07-.6 1 .07 1.52 1.03 1.52 1.03.88 1.5 2.3 1.07 2.87.82.09-.64.35-1.07.63-1.32-2.22-.25-4.55-1.1-4.55-4.93 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0 1 12 7.01c.85 0 1.7.11 2.5.34 1.9-1.29 2.74-1.02 2.74-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.58c0 .26.18.58.69.48A10 10 0 0 0 12 2Z"
							/>
						</svg>
					</a>
				</li>
				<li>
					<a
						class="site-header__icon-link"
						href={site.linkedinUrl}
						target="_blank"
						rel="noreferrer"
						aria-label="LinkedIn"
					>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path
								d="M5.37 8.42h3.06V18H5.37V8.42Zm1.53-4.76a1.77 1.77 0 1 1 0 3.54 1.77 1.77 0 0 1 0-3.54ZM10.28 8.42h2.93v1.31h.04a3.21 3.21 0 0 1 2.89-1.59c3.09 0 3.66 2.03 3.66 4.67V18h-3.05v-4.6c0-1.1-.02-2.5-1.53-2.5-1.53 0-1.76 1.2-1.76 2.43V18h-3.05V8.42Z"
							/>
						</svg>
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>
